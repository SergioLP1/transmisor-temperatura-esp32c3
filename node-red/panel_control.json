    {
        "id": "function-setpoint-validate",
        "type": "function",
        "z": "furnace-flow",
        "name": "Validate & Send",
        "func": "var value = msg.payload;\nif (value >= 30 && value <= 150) {\n    msg.payload = value;\n    return msg;\n} else {\n    node.warn(\"Setpoint out of range: \" + value);\n    return null;\n}",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 480,
        "y": 600,
        "wires": [
            [
                "function-setpoint"
            ]
        ]
    },
    {
        "id": "function-setpoint",
        "type": "function",
        "z": "furnace-flow",
        "name": "Format Setpoint",
        "func": "var setpoint = msg.payload;\nif (setpoint < 0) setpoint = 0;\nif (setpoint > 150) setpoint = 400;\nmsg.payload = setpoint;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 660,
        "y": 660,
        "wires": [
            [
                "mqtt-out-setpoint",
                "update-setpoint-display"
            ]
        ]
    },
    {
        "id": "update-setpoint-display",
        "type": "function",
        "z": "furnace-flow",
        "name": "Update Display",
        "func": "var setpoint = msg.payload;\n// Actualizar el texto del setpoint\nreturn msg;",
